# Sovereign Industrial AI Workbench — frontend environment
#
# Leave BOTH blank to use same-origin (recommended). Same-origin works for:
#   - `npm run dev`      -> Vite proxies /api and /ws to 127.0.0.1:8000
#   - `docker compose up`-> nginx proxies /api and /ws to the backend container
#   - iPad / LAN access  -> resolves against whatever host the browser used
#
# Only set these when the API lives on a DIFFERENT host/port than the UI.
# Never hardcode localhost here: a tablet cannot reach your laptop's localhost.
VITE_API_BASE=
VITE_WS_BASE=

# Example for a split deployment (backend on the workstation, UI served elsewhere):
# VITE_API_BASE=http://192.168.1.24:8000
# VITE_WS_BASE=ws://192.168.1.24:8000

# Enables the dev-only "Autofill TOTP" helper on the MFA screen.
# Set to false for production / demo-day builds.
VITE_DEV_MODE=true
