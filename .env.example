# Sovereign Industrial AI Workbench Environment Configuration
ENVIRONMENT=development
PROJECT_NAME="Sovereign Industrial AI Workbench"
VERSION="1.0.0"
API_V1_STR="/api"

# Server Configuration
HOST=0.0.0.0
PORT=8000
SECRET_KEY=sovereign_industrial_super_secure_jwt_secret_key_2026_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL by default, auto-fallback to local SQLite if offline)
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sovereign_workbench
POSTGRES_PORT=5432
DATABASE_URL=sqlite:///./sovereign_workbench.db

# Redis Configuration (with in-memory fallback)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Storage Directories
STORAGE_DIR=./data/storage
DOCUMENTS_DIR=./data/documents
VECTOR_DB_DIR=./data/vectordb
AUDIT_LOG_DIR=./data/audit

# Hardware & Model Configuration
HARDWARE_TIER_OVERRIDE=
MAX_RAM_ALLOCATION_GB=4.0
SELECTED_MODEL_TYPE=local_neural_cpu
LOCAL_MODEL_PATH=./models
EMBEDDING_MODEL_TYPE=local_semantic

# Security
MFA_ISSUER="Sovereign Industrial AI"
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
PROMPT_GUARD_ENABLED=true
OUTPUT_GUARD_ENABLED=true
